generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INTERVIEWER
  CANDIDATE
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String         @unique
  passwordHash  String
  role          Role           @default(CANDIDATE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  submissions   Submission[]
  drafts        CodeDraft[]
  challengeProgress ChallengeProgress[]

  @@map("users")
}

model Problem {
  id                String             @id @default(cuid())
  slug              String             @unique
  title             String
  difficulty        String
  statementMd       String             @map("statement_md") @db.Text
  constraintsMd     String             @map("constraints_md") @db.Text
  timeLimitMs       Int                @default(2000) @map("time_limit_ms")
  memoryLimitMb     Int                @default(256) @map("memory_limit_mb")
  status            String             @default("PUBLISHED")
  version           Int                @default(1)
  kind              String             @default("QUESTION")
  challengeEndsAt   DateTime?          @map("challenge_ends_at")
  publishAfterChallenge Boolean        @default(false) @map("publish_after_challenge")
  starterCode       Json?              @map("starter_code")
  examples          ProblemExample[]
  testCases         TestCase[]
  officialSolutions OfficialSolution[]
  submissions       Submission[]
  tags              ProblemTag[]
  drafts            CodeDraft[]
  challengeProgress ChallengeProgress[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("problems")
}

model ProblemExample {
  id          String  @id @default(cuid())
  problemId   String  @map("problem_id")
  inputText   String  @map("input_text") @db.Text
  outputText  String  @map("output_text") @db.Text
  explanation String? @db.Text
  position    Int     @default(0)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, position])
  @@index([problemId])
  @@map("problem_examples")
}

model ProblemTag {
  id       String    @id @default(cuid())
  name     String    @unique
  problems Problem[]

  @@map("problem_tags")
}

model TestCase {
  id                String   @id @default(cuid())
  problemId         String   @map("problem_id")
  visibility        String   @default("HIDDEN")
  inputKey          String   @map("input_key") @db.Text
  expectedOutputKey String   @map("expected_output_key") @db.Text
  points            Int      @default(1)
  position          Int      @default(0)
  groupId           String?  @map("group_id")
  createdAt         DateTime @default(now()) @map("created_at")

  problem Problem                @relation(fields: [problemId], references: [id], onDelete: Cascade)
  results SubmissionTestResult[]

  @@unique([problemId, position])
  @@index([problemId, visibility])
  @@map("test_cases")
}

model OfficialSolution {
  id          String @id @default(cuid())
  problemId   String @map("problem_id")
  language    String
  sourceKey   String @map("source_key") @db.Text
  editorialMd String @map("editorial_md") @db.Text
  visibility  String @default("PRIVATE")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, language])
  @@index([problemId])
  @@map("official_solutions")
}

model CodeDraft {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  language  String
  code      String
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, language])
  @@map("code_drafts")
}

model Submission {
  id                  String                   @id @default(cuid())
  problemId           String                   @map("problem_id")
  userId              String                   @map("user_id")
  language            String
  mode                String                   @default("SUBMIT") @map("execution_mode")
  scoreAwarded        Float?                   @map("score_awarded")
  sourceKey           String                   @map("source_key") @db.Text
  status              SubmissionStatus         @default(PENDING)
  verdict             String?
  stdout              String?
  stderr              String?
  runtimeMs           Int?                     @map("runtime_ms")
  memoryKb            Int?                     @map("memory_kb")
  passedTestCases     Int?                     @map("passed_test_cases")
  totalTestCases      Int?                     @map("total_test_cases")
  failedTestCase      Json?                    @map("failed_test_case")
  runtimeIntelligence Json?                    @map("runtime_intelligence")
  createdAt           DateTime                 @default(now()) @map("created_at")
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem             Problem                  @relation(fields: [problemId], references: [id], onDelete: Restrict)
  testResults         SubmissionTestResult[]
  feedback            SubmissionFeedback?
  errorFeedback       SubmissionErrorFeedback?

  @@index([userId, createdAt])
  @@index([problemId, createdAt])
  @@index([userId, problemId, mode, createdAt])
  @@map("submissions")
}

model ChallengeProgress {
  id             String    @id @default(cuid())
  problemId      String    @map("problem_id")
  userId         String    @map("user_id")
  runCount       Int       @default(0) @map("run_count")
  submissionCount Int      @default(0) @map("submission_count")
  firstRunPassed Boolean   @default(false) @map("first_run_passed")
  currentScore   Float     @default(0) @map("current_score")
  bestScore      Float     @default(0) @map("best_score")
  solvedAt       DateTime? @map("solved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId])
  @@index([problemId, bestScore])
  @@index([userId, updatedAt])
  @@map("challenge_progress")
}

model SubmissionTestResult {
  id           String @id @default(cuid())
  submissionId String @map("submission_id")
  testCaseId   String @map("test_case_id")
  verdict      String
  runtimeMs    Int?   @map("runtime_ms")
  memoryKb     Int?   @map("memory_kb")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Restrict)

  @@unique([submissionId, testCaseId])
  @@index([submissionId])
  @@map("submission_test_results")
}

model SubmissionFeedback {
  id                 String   @id @default(cuid())
  submissionId       String   @unique
  summary            String
  strengths          Json
  weaknesses         Json
  optimizations      Json
  complexityEstimate String
  readabilityScore   Int
  createdAt          DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_feedbacks")
}

model SubmissionErrorFeedback {
  id            String   @id @default(cuid())
  submissionId  String   @unique
  errorType     String
  agentResponse Json
  createdAt     DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_error_feedbacks")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
